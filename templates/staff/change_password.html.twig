{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}
{% block page_title %}Change Password{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-slate-500 mt-2">Keep your staff account protected with a strong passphrase.</p>
{% endblock %}

{% block body %}
<div class="max-w-2xl">
    <div class="card-surface rounded-3xl p-6">
        <h2 class="text-lg font-semibold text-slate-900">Update your password</h2>
        <p class="text-sm text-slate-500 mt-1">Minimum 12 characters recommended.</p>

        <div class="mt-6 space-y-4 text-sm">
            {{ form_start(form) }}
                <div class="space-y-4">
                    <div class="rounded-2xl bg-slate-50 p-4">
                        {{ form_row(form.currentPassword) }}
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        {{ form_row(form.newPassword) }}
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        {{ form_row(form.confirmPassword) }}
                    </div>
                </div>
                <div class="mt-6 flex flex-wrap gap-3">
                    <button type="submit" class="px-4 py-2 rounded-full bg-teal-600 text-white text-sm">Change Password</button>
                    <a href="{{ path('staff_profile') }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">Back to Profile</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
