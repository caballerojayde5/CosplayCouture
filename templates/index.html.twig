    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
        --ink: #0f1a23;
        --slate: #1f2a36;
        --fog: #f7f3ec;
        --mist: #ebe4d8;
        --teal: #2a9d8f;
        --teal-dark: #1f7a70;
        --gold: #c58f3a;
        --rose: #b45d5c;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        color: var(--ink);
        background: linear-gradient(160deg, #d1fae5 0%, #fbcfe8 50%, #e9d5ff 100%);
        background-attachment: fixed;
        min-height: 100vh;
        }
        .brand { font-family: "Fraunces", "Times New Roman", serif; letter-spacing: 0.02em; }
        .panel {
        background: rgba(255,255,255,0.82);
        border: 1px solid rgba(15,26,35,0.08);
        box-shadow: 0 16px 40px rgba(15,26,35,0.08);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        }
        .card-surface {
        background: rgba(255,255,255,0.88);
        border: 1px solid rgba(15,26,35,0.07);
        box-shadow: 0 8px 24px rgba(15,26,35,0.07);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        }
        .btn-teal {
        background: var(--teal);
        color: #fff;
        padding: 0.75rem 1.75rem;
        border-radius: 999px;
        font-weight: 500;
        font-size: 0.9375rem;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s, transform 0.15s;
        }
        .btn-teal:hover { background: var(--teal-dark); transform: translateY(-1px); }
        .btn-outline {
        border: 1.5px solid var(--ink);
        color: var(--ink);
        padding: 0.72rem 1.75rem;
        border-radius: 999px;
        font-weight: 500;
        font-size: 0.9375rem;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s, transform 0.15s;
        }
        .btn-outline:hover { background: rgba(15,26,35,0.06); transform: translateY(-1px); }
        .teal-tag {
        display: inline-flex; align-items: center; gap: 0.4rem;
        font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--teal-dark);
        background: rgba(42,157,143,0.1);
        border: 1px solid rgba(42,157,143,0.25);
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        margin-bottom: 1.25rem;
        width: fit-content;
        }
        .fade-up { opacity: 0; transform: translateY(22px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .fade-up.visible { opacity: 1; transform: none; }
        /* NAV */
        nav {
        position: sticky; top: 0; z-index: 50;
        padding: 1rem 1.5rem;
        }
        .nav-inner {
        max-width: 1200px; margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        background: rgba(255,255,255,0.78);
        border: 1px solid rgba(15,26,35,0.07);
        box-shadow: 0 8px 24px rgba(15,26,35,0.06);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-radius: 1.25rem;
        padding: 0.75rem 1.5rem;
        }
        .nav-logo { font-family: "Fraunces", serif; font-size: 1.3rem; color: var(--ink); text-decoration: none; letter-spacing: 0.02em; }
        .nav-links { display: flex; gap: 2rem; list-style: none; }
        .nav-links a { color: rgba(15,26,35,0.7); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.2s; }
        .nav-links a:hover { color: var(--teal); }
        .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 4px; }
        .hamburger span { display: block; width: 20px; height: 1.5px; background: var(--ink); transition: 0.3s; }
        .mobile-menu {
        display: none; position: fixed; inset: 0; z-index: 200;
        background: rgba(255,255,255,0.96);
        flex-direction: column; align-items: center; justify-content: center; gap: 2rem;
        }
        .mobile-menu.open { display: flex; }
        .mobile-menu a { font-family: "Fraunces", serif; font-size: 2rem; color: var(--ink); text-decoration: none; }
        .mobile-close { position: absolute; top: 1.5rem; right: 1.5rem; font-size: 1.5rem; cursor: pointer; background: none; border: none; color: var(--ink); }
        /* SECTIONS */
        section { padding: 6rem 1.5rem; }
        .container { max-width: 1200px; margin: 0 auto; }
        /* HERO */
        #hero { padding-top: 5rem; padding-bottom: 6rem; }
        .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
        .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--teal-dark); background: rgba(42,157,143,0.1); border: 1px solid rgba(42,157,143,0.25); padding: 0.3rem 0.85rem; border-radius: 999px; margin-bottom: 1.5rem; }
        .hero-headline { font-family: "Fraunces", serif; font-size: clamp(2.75rem, 5.5vw, 4.5rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 1.5rem; }
        .hero-headline em { font-style: italic; color: var(--teal); }
        .hero-sub { font-size: 1.0625rem; color: rgba(15,26,35,0.65); line-height: 1.8; margin-bottom: 2.25rem; max-width: 460px; }
        .hero-actions { display: flex; gap: 0.875rem; flex-wrap: wrap; }
        .hero-visual {
        border-radius: 2rem;
        aspect-ratio: 4/5;
        background: linear-gradient(145deg, rgba(42,157,143,0.15), rgba(197,143,58,0.1), rgba(180,93,92,0.1));
        border: 1px solid rgba(42,157,143,0.18);
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 1rem; padding: 2rem;
        position: relative; overflow: hidden;
        }
        .hero-visual::before {
        content: '';
        position: absolute; inset: 0;
        background: radial-gradient(ellipse at 30% 20%, rgba(42,157,143,0.12), transparent 60%),
                    radial-gradient(ellipse at 70% 80%, rgba(197,143,58,0.1), transparent 60%);
        }
        .costume-pill {
        background: rgba(255,255,255,0.9); border: 1px solid rgba(15,26,35,0.07);
        border-radius: 999px; padding: 0.6rem 1.1rem;
        display: flex; align-items: center; gap: 0.6rem;
        font-size: 0.875rem; font-weight: 500; color: var(--ink);
        box-shadow: 0 4px 12px rgba(15,26,35,0.07);
        position: relative; z-index: 1;
        }
        .costume-pill .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .hero-stats { display: flex; gap: 2rem; margin-top: 2.5rem; }
        .hero-stat .num { font-family: "Fraunces", serif; font-size: 2rem; font-weight: 700; color: var(--ink); }
        .hero-stat .lbl { font-size: 0.75rem; color: rgba(15,26,35,0.55); margin-top: 0.15rem; text-transform: uppercase; letter-spacing: 0.08em; }
        /* MARQUEE */
        .marquee-strip {
        background: var(--ink); color: rgba(255,255,255,0.7);
        padding: 0.9rem 0; overflow: hidden;
        font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
        }
        .marquee-track { display: flex; gap: 3rem; animation: marquee 22s linear infinite; white-space: nowrap; }
        .marquee-track span { color: var(--gold); }
        @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
        /* CATEGORIES */
        .category-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; margin-top: 3rem; }
        .cat-card {
        border-radius: 1.5rem; padding: 2rem 1.5rem;
        display: flex; flex-direction: column; gap: 0.75rem;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none; color: inherit;
        }
        .cat-card:hover { transform: translateY(-4px); box-shadow: 0 20px 48px rgba(15,26,35,0.1); }
        .cat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 0.25rem; }
        .cat-card h3 { font-family: "Fraunces", serif; font-size: 1.3rem; font-weight: 600; }
        .cat-card p { font-size: 0.875rem; color: rgba(15,26,35,0.6); line-height: 1.6; }
        /* PROCESS */
        .process-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1.5rem; margin-top: 3rem; }
        .proc-card { border-radius: 1.25rem; padding: 1.75rem 1.5rem; }
        .proc-num { font-family: "Fraunces", serif; font-size: 2.5rem; font-weight: 700; color: var(--teal); opacity: 0.5; line-height: 1; margin-bottom: 1rem; }
        .proc-card h4 { font-family: "Fraunces", serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; }
        .proc-card p { font-size: 0.875rem; color: rgba(15,26,35,0.6); line-height: 1.65; }
        /* FEATURED */
        .product-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; margin-top: 3rem; }
        .product-card { border-radius: 1.5rem; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s; display: block; }
        .product-card:hover { transform: translateY(-4px); }
        .product-img { aspect-ratio: 3/4; background: linear-gradient(145deg, var(--c1), var(--c2)); display: flex; align-items: center; justify-content: center; font-size: 4rem; position: relative; }
        .product-badge { position: absolute; top: 0.75rem; left: 0.75rem; font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.65rem; border-radius: 999px; background: rgba(255,255,255,0.92); color: var(--ink); }
        .product-body { padding: 1.25rem; }
        .product-body h4 { font-family: "Fraunces", serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 0.25rem; }
        .product-body .category { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(15,26,35,0.5); margin-bottom: 0.6rem; }
        .product-price { font-size: 1rem; font-weight: 600; color: var(--teal-dark); }
        /* TESTIMONIALS */
        .testi-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; margin-top: 3rem; }
        .testi-card { border-radius: 1.5rem; padding: 1.75rem; }
        .stars { color: var(--gold); font-size: 0.875rem; margin-bottom: 0.75rem; }
        .testi-quote { font-family: "Fraunces", serif; font-style: italic; font-size: 1rem; line-height: 1.65; color: var(--ink); margin-bottom: 1.25rem; }
        .testi-author { display: flex; align-items: center; gap: 0.75rem; }
        .testi-avatar { width: 36px; height: 36px; border-radius: 50%; background: rgba(42,157,143,0.15); border: 1px solid rgba(42,157,143,0.25); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: var(--teal-dark); }
        .testi-name { font-size: 0.875rem; font-weight: 500; }
        .testi-loc { font-size: 0.75rem; color: rgba(15,26,35,0.5); }
        /* CTA BAND */
        #cta-band { padding: 5rem 1.5rem; }
        .cta-inner { max-width: 1200px; margin: 0 auto; border-radius: 2rem; padding: 4rem; background: var(--ink); color: #fff; text-align: center; position: relative; overflow: hidden; }
        .cta-inner::before { content:''; position:absolute; inset:0; background: radial-gradient(ellipse at 30% 50%, rgba(42,157,143,0.25), transparent 60%), radial-gradient(ellipse at 70% 50%, rgba(197,143,58,0.15), transparent 60%); }
        .cta-inner h2 { font-family:"Fraunces",serif; font-size:clamp(2rem,4vw,3rem); font-weight:700; margin-bottom:1rem; position:relative; }
        .cta-inner h2 em { font-style:italic; color: var(--gold); }
        .cta-inner p { color:rgba(255,255,255,0.65); font-size:1.0625rem; max-width:500px; margin:0 auto 2rem; position:relative; }
        .cta-inner .btn-gold { background: var(--gold); color: var(--ink); padding: 0.8rem 2rem; border-radius:999px; font-weight:600; text-decoration:none; display:inline-block; font-size:0.9375rem; transition:filter 0.2s; position:relative; }
        .cta-inner .btn-gold:hover { filter:brightness(1.1); }
        /* FOOTER */
        footer { background: var(--ink); color: rgba(255,255,255,0.65); }
        .footer-inner { max-width:1200px; margin:0 auto; padding: 4rem 1.5rem 2rem; display:grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap:3rem; }
        .footer-brand { font-family:"Fraunces",serif; font-size:1.4rem; color:#fff; margin-bottom:0.75rem; }
        .footer-sub { font-size:0.875rem; line-height:1.7; color:rgba(255,255,255,0.5); max-width:240px; }
        .footer-col h5 { font-size:0.7rem; text-transform:uppercase; letter-spacing:0.15em; color:rgba(255,255,255,0.4); margin-bottom:1rem; }
        .footer-col a { display:block; color:rgba(255,255,255,0.6); text-decoration:none; font-size:0.875rem; margin-bottom:0.6rem; transition:color 0.2s; }
        .footer-col a:hover { color:#fff; }
        .footer-bottom { max-width:1200px; margin:0 auto; padding: 1.5rem 1.5rem 2rem; border-top:1px solid rgba(255,255,255,0.08); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; font-size:0.8rem; color:rgba(255,255,255,0.35); }
        /* RESPONSIVE */
        @media (max-width: 1024px) {
        .hero-grid { grid-template-columns: 1fr; gap: 3rem; }
        .hero-visual { max-width: 420px; margin: 0 auto; width: 100%; }
        .category-grid { grid-template-columns: repeat(2,1fr); }
        .process-grid { grid-template-columns: repeat(2,1fr); }
        .product-grid { grid-template-columns: repeat(2,1fr); }
        .footer-inner { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 640px) {
        section { padding: 4rem 1.25rem; }
        .nav-links { display: none; }
        .hamburger { display: flex; }
        .hero-stats { gap: 1.5rem; }
        .category-grid, .process-grid, .product-grid, .testi-grid { grid-template-columns: 1fr; }
        .cta-inner { padding: 2.5rem 1.5rem; }
        .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
        }
    </style>
