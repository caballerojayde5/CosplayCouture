{% extends 'base.html.twig' %}

{% block title %}Send Message{% endblock %}
{% block page_title %}Send Message{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-slate-500 mt-2">Share customer inquiries with the admin team.</p>
{% endblock %}

{% block body %}
<div class="max-w-3xl">
    <div class="card-surface rounded-3xl p-6">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
            <h2 class="text-lg font-semibold text-slate-900">Message details</h2>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_dashboard') }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">Back to Dashboard</a>
            {% else %}
                <a href="{{ path('app_staff_index') }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">Back to Dashboard</a>
            {% endif %}
        </div>

        <form method="post" class="mt-6 space-y-4 text-sm">
            <div class="rounded-2xl bg-slate-50 p-4">
                <label for="name" class="text-xs uppercase tracking-[0.2em] text-slate-500">Name</label>
                <input type="text" id="name" name="name" class="mt-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-700" required>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <label for="email" class="text-xs uppercase tracking-[0.2em] text-slate-500">Email</label>
                <input type="email" id="email" name="email" value="{{ app.user ? app.user.email : '' }}" class="mt-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-700" required>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <label for="subject" class="text-xs uppercase tracking-[0.2em] text-slate-500">Subject</label>
                <input type="text" id="subject" name="subject" class="mt-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-700" required>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <label for="message" class="text-xs uppercase tracking-[0.2em] text-slate-500">Message</label>
                <textarea id="message" name="message" rows="6" class="mt-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-700" required></textarea>
            </div>

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="px-4 py-2 rounded-full bg-teal-600 text-white text-sm">Send Message</button>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">Back to Dashboard</a>
                {% else %}
                    <a href="{{ path('app_staff_index') }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">Back to Dashboard</a>
                {% endif %}
            </div>
        </form>
    </div>
</div>
{% endblock %}
