<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email — Cosplay Couture</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f3ec;font-family:'Segoe UI',Arial,sans-serif;">

  <!-- Wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0"
         style="background-color:#f7f3ec;padding:40px 16px;">
    <tr>
      <td align="center">

        <!-- Card -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0"
               style="max-width:520px;background-color:#ffffff;border-radius:20px;
                      border:1px solid rgba(197,143,58,0.22);
                      box-shadow:0 8px 32px rgba(15,26,35,0.10);">

          <!-- Header -->
          <tr>
            <td align="center"
                style="background:linear-gradient(135deg,#2a9d8f 0%,#1f7a70 100%);
                       border-radius:20px 20px 0 0;padding:36px 40px 30px;">

              <!-- Crown Icon -->
              <div style="display:inline-block;background:rgba(255,255,255,0.18);
                          border-radius:12px;padding:10px 12px;margin-bottom:14px;">
                <img src="https://img.icons8.com/ios/50/ffffff/sewing-machine.png"
                     width="28" height="28" alt="Cosplay Couture"
                     style="display:block;">
              </div>

              <div style="font-family:Georgia,serif;font-size:26px;font-weight:700;
                          color:#ffffff;letter-spacing:.03em;margin-bottom:4px;">
                Cosplay Couture
              </div>
              <div style="font-family:Georgia,serif;font-style:italic;
                          font-size:13px;color:rgba(255,255,255,0.72);letter-spacing:.06em;">
                Step into Character, Anytime, Anywhere
              </div>

            </td>
          </tr>

          <!-- Divider Star -->
          <tr>
            <td align="center" style="padding:20px 40px 0;">
              <span style="color:#c58f3a;font-size:11px;letter-spacing:.3em;">✦ ✦ ✦</span>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:28px 44px 36px;">

              <!-- Greeting -->
              <p style="margin:0 0 16px;font-size:20px;font-weight:600;
                         color:#0f1a23;letter-spacing:.01em;">
                Hi {{ user.email }}! 👋
              </p>

              <p style="margin:0 0 24px;font-size:14.5px;line-height:1.7;color:#3a4a58;">
                Thank you for joining <strong>Cosplay Couture</strong>! You're one step away
                from stepping into character. Please verify your email address to activate
                your account.
              </p>

              <!-- CTA Button -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="margin-bottom:28px;">
                <tr>
                  <td align="center">
                    <a href="{{ verificationUrl }}"
                       style="display:inline-block;padding:14px 36px;
                              background-color:#2a9d8f;color:#ffffff;
                              text-decoration:none;border-radius:999px;
                              font-size:13px;font-weight:600;
                              letter-spacing:.1em;text-transform:uppercase;
                              box-shadow:0 6px 20px rgba(42,157,143,0.30);">
                      Verify My Email Address
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Fallback URL -->
              <p style="margin:0 0 8px;font-size:12.5px;color:#7a8a98;">
                Or copy and paste this link into your browser:
              </p>
              <p style="margin:0 0 24px;font-size:11.5px;word-break:break-all;
                         color:#2a9d8f;background:#f0faf9;padding:10px 14px;
                         border-radius:8px;border:1px solid rgba(42,157,143,0.18);">
                {{ verificationUrl }}
              </p>

              <!-- Disclaimer -->
              <p style="margin:0;font-size:12px;color:#a0aab4;line-height:1.6;
                         border-top:1px solid #eee;padding-top:20px;">
                If you did not create a Cosplay Couture account, you can safely ignore
                this email. No action is required.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
                style="background:#f7f3ec;border-radius:0 0 20px 20px;
                       padding:18px 40px;border-top:1px solid rgba(15,26,35,0.07);">
              <span style="font-family:Georgia,serif;font-style:italic;
                           font-size:12px;color:rgba(15,26,35,0.38);letter-spacing:.04em;">
                Where every costume tells a story
              </span><br>
              <span style="font-size:10px;font-weight:600;letter-spacing:.12em;
                           text-transform:uppercase;color:#1f7a70;opacity:.65;">
                ✦ Handcrafted in Manila ✦
              </span>
            </td>
          </tr>

        </table>
        <!-- /Card -->

      </td>
    </tr>
  </table>

</body>
</html>