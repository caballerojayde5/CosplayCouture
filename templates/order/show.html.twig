{% extends 'base.html.twig' %}

{% block title %}{{ order.customerName }}'s Order{% endblock %}
{% block page_title %}Order Details{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-slate-500 mt-2">Order #{{ order.id }} for {{ order.customerName }}.</p>
{% endblock %}

{% block body %}
<div class="grid gap-6 max-w-5xl">
    <section class="card-surface rounded-3xl p-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-lg font-semibold text-slate-900">{{ order.customerName }}</h2>
            <p class="text-sm text-slate-500 mt-1">{{ order.email }}</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="group flex items-center gap-2 px-4 py-2 rounded-full bg-amber-100 text-amber-800 text-sm transition hover:-translate-y-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit
            </a>
            <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" class="inline" onsubmit="return confirm('Delete this order?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                <button type="submit" class="group flex items-center gap-2 px-4 py-2 rounded-full bg-rose-100 text-rose-700 text-sm transition hover:-translate-y-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete
                </button>
            </form>
            <a href="{{ path('app_order_index') }}" class="group flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm transition hover:-translate-y-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Orders
            </a>
        </div>
    </section>

    <section class="card-surface rounded-3xl p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Customer Name</p>
                <p class="mt-2 text-base font-medium text-slate-900">{{ order.customerName }}</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Email</p>
                <p class="mt-2 text-base font-medium text-slate-900">{{ order.email }}</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Cosplay Name</p>
                <p class="mt-2 text-base font-medium text-slate-900">{{ order.cosplayName }}</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Status</p>
                <p class="mt-2 text-base font-medium text-slate-900">{{ order.status }}</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4 md:col-span-2">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Address</p>
                <p class="mt-2 text-slate-700">{{ order.address ?: 'Not provided' }}</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Created</p>
                <p class="mt-2 text-base font-medium text-slate-900">{{ order.createdAt|date('Y-m-d H:i') }}</p>
            </div>
        </div>
    </section>
</div>
{% endblock %}
