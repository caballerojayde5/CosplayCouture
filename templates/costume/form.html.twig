{% set backPath = back_path|default('app_costume_index') %}
{% set backLabel = back_label|default('Back to Products') %}

{{ form_start(form, {'attr': {'class':'space-y-4'}}) }}
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {{ form_row(form.name) }}
    {{ form_row(form.category) }}
    {{ form_row(form.price) }}
    {{ form_row(form.stockQuantity) }}
    {{ form_row(form.imageUrl) }}
    <div class="md:col-span-2">{{ form_row(form.description) }}</div>
</div>

<div class="flex flex-wrap gap-3 pt-2">
    <button type="submit" class="px-4 py-2 rounded-full bg-teal-600 text-white text-sm">
        {{ button_label|default('Save') }}
    </button>
    <a href="{{ path(backPath) }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">{{ backLabel }}</a>
</div>
{{ form_end(form) }}
