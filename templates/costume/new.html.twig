{% extends 'base.html.twig' %}

{% block title %}Add New Product{% endblock %}
{% block page_title %}New Product{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-slate-500 mt-2">Create a new costume listing.</p>
{% endblock %}

{% block body %}
<div class="max-w-4xl">
    <div class="card-surface rounded-3xl p-6">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
            <h2 class="text-lg font-semibold text-slate-900">Product details</h2>
            <a href="{{ path('app_costume_index') }}" class="group flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm transition hover:-translate-y-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Products
            </a>
        </div>

        <div class="mt-6">
            {% include 'costume/form.html.twig' with {
                'form': form,
                'button_label': 'Create',
                'back_path': 'app_costume_index',
                'back_label': 'Back to Products'
            } %}
        </div>
    </div>
</div>
{% endblock %}
