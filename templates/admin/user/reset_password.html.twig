{% extends 'base.html.twig' %}

{% block title %}Reset Password{% endblock %}
{% block page_title %}Reset Password{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-slate-500 mt-2">Set a new password for {{ user.email }}.</p>
{% endblock %}

{% block body %}
<div class="max-w-2xl">
    <div class="card-surface rounded-3xl p-6">
        <h2 class="text-lg font-semibold text-slate-900">New password</h2>
        <p class="text-sm text-slate-500 mt-1">Share the updated credentials securely.</p>

        <div class="mt-6 space-y-4 text-sm">
            {{ form_start(form) }}
                <div class="rounded-2xl bg-slate-50 p-4">
                    {{ form_row(form.newPassword) }}
                </div>
                <div class="mt-6 flex flex-wrap gap-3">
                    <button type="submit" class="px-4 py-2 rounded-full bg-teal-600 text-white text-sm">{{ button_label|default('Reset Password') }}</button>
                    <a href="{{ path('admin_users_index') }}" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-sm">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
