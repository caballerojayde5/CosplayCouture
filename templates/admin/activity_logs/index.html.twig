{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}
{% block page_title %}Activity Logs{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-slate-500 mt-2">Track admin and staff actions across the studio.</p>
{% endblock %}

{% block body %}
<div class="card-surface rounded-3xl p-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <h2 class="text-lg font-semibold text-slate-900">Recent activity</h2>
        <span class="text-xs uppercase tracking-[0.2em] text-slate-400">Audit trail</span>
    </div>

    <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-xs">
                <tr>
                    <th class="px-4 py-3 text-left">Date / Time</th>
                    <th class="px-4 py-3 text-left">User</th>
                    <th class="px-4 py-3 text-left">Role</th>
                    <th class="px-4 py-3 text-left">Action</th>
                        <th class="px-4 py-3 text-left">Details</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-700">
                {% for log in logs %}
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-3 whitespace-nowrap text-slate-900">
                        {{ log.timestamp|date('Y-m-d H:i:s') }}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">{{ log.user.email }}</td>
                    <td class="px-4 py-3 whitespace-nowrap">
                        {% if 'ROLE_ADMIN' in log.user.roles %}
                            Admin
                        {% elseif 'ROLE_STAFF' in log.user.roles %}
                            Staff
                        {% else %}
                            User
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">{{ log.eventType }}</td>
                    <td class="px-4 py-3">{{ log.details }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-slate-500">No activity logs found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
